# ANTHROPIC_API_KEY: paste from https://console.anthropic.com/settings/keys
# — required for the Phase 3 AI generation pipeline.
# ANTHROPIC_API_KEY=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# RESEND_FROM=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# RESEND_TOKEN=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# STRIPE_SECRET_KEY=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# STRIPE_WEBHOOK_SECRET=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# Phase 7: Google Cloud OAuth 2.0 Client (Web application) with the Search
# Console API enabled — add "${NEXT_PUBLIC_APP_URL}/api/search-console/callback"
# as an authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# GOOGLE_OAUTH_CLIENT_SECRET=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# GSC_OAUTH_STATE_SECRET=""  # any long random string — signs the OAuth `state` param, generate with e.g. `openssl rand -hex 32`
# Phase 8: same Google Cloud OAuth Client as above (GOOGLE_OAUTH_CLIENT_ID/
# SECRET), just requesting the additional adwords scope — enable the Google
# Ads API on that project and add
# "${NEXT_PUBLIC_APP_URL}/api/google-ads/callback" as an authorized redirect
# URI. GOOGLE_ADS_DEVELOPER_TOKEN comes from a Google Ads manager (MCC)
# account's API Center, not the Cloud Console.
# GOOGLE_ADS_OAUTH_STATE_SECRET=""  # any long random string, distinct from GSC_OAUTH_STATE_SECRET — generate with e.g. `openssl rand -hex 32`
# GOOGLE_ADS_DEVELOPER_TOKEN=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""  # the MCC account's customer id
# GOOGLE_ADS_DEFAULT_GEO_TARGET_CONSTANT=""  # optional, e.g. "geoTargetConstants/2840" (US) — defaults to US if unset
# GOOGLE_ADS_DEFAULT_LANGUAGE_CONSTANT=""  # optional, e.g. "languageConstants/1000" (English) — defaults to English if unset
# BETTERSTACK_API_KEY=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# BETTERSTACK_URL=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# FLAGS_SECRET=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# ARCJET_KEY=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# SVIX_TOKEN=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# LIVEBLOCKS_SECRET=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
# BASEHUB_TOKEN=""  # leave unset (not empty-string) - optional zod url/format validators reject "" as invalid, fill in and uncomment to enable
